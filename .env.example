# Copy to .env; existing environment variables take precedence.
RAGEVAL_DATA_DIR=data

# Local retrieval; first use downloads the embedding model.
RAG_EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
RAG_EMBEDDING_DEVICE=cpu
RAG_EMBEDDING_CACHE_DIR=.cache/huggingface
RAG_EMBEDDING_QUERY_INSTRUCTION=为这个句子生成表示以用于检索相关文章：
RAG_CHROMA_DIR=.cache/chroma
RAG_CHROMA_COLLECTION=ecommerce_v1

# Required only for generation. Supply your provider's full API base URL (usually ending in /v1).
RAG_API_KEY=
RAG_BASE_URL=
RAG_MODEL=
# Total transport attempts (1-5): retry 429, timeout, connection errors and 5xx.
RAG_MAX_ATTEMPTS=3
# Exponential backoff; each wait is capped at 30 seconds. Must be >0 and <=30.
RAG_RETRY_DELAY_SECONDS=5
# Per-request deadline, seconds, in (0, 120]. Cancels an unfinished async request.
RAG_GENERATION_TIMEOUT_SECONDS=60
# Optional provider extension for supported GLM models: enabled/disabled; empty omits it.
RAG_THINKING=

# Independent LLM-as-Judge service; required only for Judge calls.
JUDGE_API_KEY=
JUDGE_BASE_URL=
JUDGE_MODEL=
# Shared total budget for API retries AND JSON repair; allowed range 1-5.
JUDGE_MAX_ATTEMPTS=3
JUDGE_TIMEOUT_SECONDS=60
JUDGE_RETRY_DELAY_SECONDS=5
# json: prompt-only; json_object: provider JSON mode (GLM); json_schema: provider schema mode.
# All modes retain strict local Pydantic validation. GLM users: choose json_object.
JUDGE_RESPONSE_FORMAT=json

# Evaluation Runner: LIVE uses the Judge API; MOCK explicitly emits test placeholders.
JUDGE_MODE=LIVE
